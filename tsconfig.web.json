{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/core/chat/types.ts", "src/core/chat/conversation.ts", "src/core/chat/cost.ts", "src/core/links/registry.ts", "src/core/a2a/protocol.ts", "src/core/a2a/client.ts", "src/core/relay-term.ts", "src/core/space-sync.ts", "src/core/space-snapshots.ts", "src/core/workspace-files.ts", "src/core/cloud.ts"]
}
