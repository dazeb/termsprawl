{
  "name": "termsprawl",
  "version": "0.2.6",
  "description": "A spatial terminal manager for Linux — terminals, editors, and agents sprawled across one infinite canvas",
  "main": "out/main/index.js",
  "type": "module",
  "license": "MIT",
  "author": "termsprawl contributors",
  "homepage": "https://github.com/dazeb/termsprawl",
  "desktopName": "termsprawl",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "postinstall": "electron-rebuild -f -w node-pty",
    "make-icon": "node scripts/make-icon.mjs",
    "dist": "pnpm run build && electron-builder --linux",
    "dist:appimage": "pnpm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.3.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "canvas": "^3.2.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.termsprawl.app",
    "productName": "termsprawl",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "A spatial terminal manager for Linux — terminals sprawled across one infinite canvas",
      "maintainer": "termsprawl contributors",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "termsprawl-${version}.${ext}"
    }
  }
}
