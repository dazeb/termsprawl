import { mkdtempSync, readdirSync, readFileSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { it } from 'vitest'
import { PtyManager } from './pty-manager'
import type { CorePlatform } from './platform'

it('debug scrollback', { timeout: 25000 }, async () => {
  const userDataPath = mkdtempSync(join(tmpdir(), 'ts-scroll-debug-'))
  let captured = ''
  const platform: CorePlatform = {
    userDataPath,
    broadcast(channel, payload) {
      if (channel.startsWith('pty:data')) captured += String(payload)
    }
  }
  const manager = new PtyManager(platform)
  manager.create({ id: 'dbg', cols: 80, rows: 24, cwd: process.cwd() })
  manager.write('dbg', 'echo SCROLL_DEBUG_MARK\r')
  await new Promise((r) => setTimeout(r, 1500))
  console.log('captured has mark:', captured.includes('SCROLL_DEBUG_MARK'))
  manager.killAll()
  await new Promise((r) => setTimeout(r, 3000))
  const dir = join(userDataPath, 'terminal-scrollback')
  console.log('files after killAll:', readdirSync(dir))
  for (const f of readdirSync(dir)) {
    const content = readFileSync(join(dir, f), 'utf8')
    console.log('file', f, 'len', content.length, 'has mark:', content.includes('SCROLL_DEBUG_MARK'))
  }
  console.log('readScrollback:', manager.readScrollback('dbg')?.includes('SCROLL_DEBUG_MARK'))
})
