# deps
node_modules/

# build output
out/
dist/
release/
build/*
!build/icon.png
!build/AGENTS.md

# tsbuildinfo (incremental compiler caches)
*.tsbuildinfo

# python caches
__pycache__/
*.pyc

# logs
*.log
npm-debug.log*

# env / secrets
.env
.env.*

# editor/OS
.DS_Store
*.swp
.idea/
.vscode/

# hermes plan files
.hermes/
.worktrees/

.worktrees/

# ZCode session artifacts (plan files, session config). Not product files —
# they vary per agent/session and would otherwise make the tree look dirty to
# release.sh's clean-tree check.
.zcode/

# Agent scratch space (SDD ledgers, task briefs, review packages). Same reason
# as .zcode/ above: never product files, never committed.
.superpowers/
